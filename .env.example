# --- App Name ---
# Shown in the header next to the logo. "Powered by Open Retro" underneath it
# is fixed and not configurable.
APP_NAME="Agile Retro"

# --- Database ---
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Auth.js (NextAuth v5) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Public URL of the app (used for building magic-link URLs). No trailing slash.
APP_URL="http://localhost:3000"

# --- Microsoft Graph (transactional email: magic links, invites, notifications) ---
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
GRAPH_SENDER_EMAIL=""

# --- Initial Super Admin (consumed once by `npm run db:seed`) ---
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME="Super Admin"

# --- Realtime server ---
PORT=3000

# --- Database bootstrap ---
# On start the app applies any pending migrations and, if the database is
# completely empty, creates the Super Admin below. Point it at a blank Postgres
# and it sets itself up. Set to "false" if migrations are applied by CI or by
# hand and you want the app to start regardless.
AUTO_MIGRATE="true"

# --- Background jobs ---
# Due-date reminders and cleanup of spent login tokens / expired invitations.
# Set to "true" on EXACTLY ONE instance. Left unset, none of it runs — which is
# the safe default, because every instance that sets it will mail the same
# people the same reminders.
RUN_SCHEDULER="false"
